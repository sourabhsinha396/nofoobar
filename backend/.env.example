# Postgres — shared by the postgres service and the FastAPI app
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=algoholic
POSTGRES_PASSWORD=algoholic
POSTGRES_DB=algoholic

# App
PROJECT_NAME=algoholic
API_V1_STR=/api/v1

# Superadmin
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-random-32-plus-char-string

# CORS — regex matching every browser origin allowed to call the API with credentials.
# Default in code: ^http://(localhost|127\.0\.0\.1):3000$ (plain localhost dev).
# For the dev-subdomains workflow, set a regex that matches apex + every subdomain:
# CORS_ORIGIN_REGEX=^http://([a-z0-9-]+\.)?testholic\.test:3000$
# For prod, match your apex + subdomain pattern:
# CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?algoholic\.io$

# Tenancy
# APEX_DOMAIN: the domain whose subdomains map to tenants (acme.<APEX> -> slug=acme).
# Ignored on localhost (uses X-Tenant-Slug header). Default in code: algoholic.io.
# Set this only when running under a real apex, e.g. for the dev-subdomains workflow
# (see docs/local-setup/dev-subdomains.md).
# APEX_DOMAIN=algoholic.test

# SESSION_COOKIE_DOMAIN: scopes the session cookie to a parent domain so it crosses
# subdomains. Leave unset for localhost dev — setting a domain the request host
# isn't under will make browsers reject the cookie and break login.
# Use in prod (.algoholic.io) or with the dev-subdomains workflow (.algoholic.test).
# SESSION_COOKIE_DOMAIN=.algoholic.test
