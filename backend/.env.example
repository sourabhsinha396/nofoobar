APEX_DOMAIN=testholic.test
SESSION_COOKIE_DOMAIN=.testholic.test

# Public hostname the API is served at in prod (e.g. backend.nofoobar.com).
# Requests to this host carry X-Tenant-Slug instead of being resolved as a
# tenant subdomain. Leave empty in local dev (the API runs on a trusted
# loopback / apex host there).
API_HOST=

# Where tenants point custom-domain DNS (e.g. domains.nofoobar.com - a
# DNS-only record on the server IP). Shown as the CNAME target in org
# settings and used for the live DNS check. Empty disables checking.
# See docs/devops/custom-domains-caddy.md.
DOMAINS_CNAME_TARGET=

# Postgres - shared by the postgres service and the FastAPI app
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nofoobar
POSTGRES_PASSWORD=nofoobar
POSTGRES_DB=nofoobar

# App
PROJECT_NAME=nofoobar
API_V1_STR=/api/v1

# Superadmin
SUPERADMIN_USERNAME=team@nofoobar.com
SUPERADMIN_PASSWORD=Test@123
SESSION_SECRET=hS80oufHVMMpIqaig-es0Kh9KC5PhfG7GO5ampvj-4MoNbGgupe2s4u-JsSkBxg_

# CORS - single regex covers apex + every tenant subdomain
CORS_ORIGIN_REGEX=^http://([a-z0-9-]+\.)?testholic\.test:3000$

# Fernet key for encrypting tenant payment-provider secrets at rest.
SECRETS_ENCRYPTION_KEY=thisismysecretkey!

S3_ENDPOINT_URL=https://yourawsid.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=c893jd
S3_SECRET_ACCESS_KEY=e90293
S3_BUCKET=yourbucketname
S3_PUBLIC_URL_BASE=https://cdn.domain.com

MUX_TOKEN_ID=54a7
